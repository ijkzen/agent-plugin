{
  "description": "agent-plugin hooks: auto-format and quality gates",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write(*.py)",
        "hooks": [
          {
            "type": "command",
            "command": "ruff check --fix ${CLAUDE_PLUGIN_ROOT}/$CLAUDE_FILE_PATHS",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[agent-plugin] Claude finished a response'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "This session has the agent-plugin enabled. Available: /task-runner (task planning), /code-reviewer (code review), @reviewer (subagent)."
          }
        ]
      }
    ]
  }
}
